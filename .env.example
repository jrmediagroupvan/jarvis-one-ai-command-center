# Managed by setup.py on first run. Never commit your real .env file.
JARVIS_USERNAME=admin
JARVIS_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD

# Choose a hosted AI provider. API keys are never required for local dashboard use.
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Printer access codes are optional. Set corresponding values when configuring printers.
BAMBU_X1C_CODE=
BAMBU_A1_CODE=
BAMBU_A2L_CODE=

# Internal application paths; keep defaults when using Docker Compose.
PRINTERS_CONFIG=/app/config/printers.json
JARVIS_DATA=/app/data

# CPU-friendly speech to text; downloads a Whisper model on first use.
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional fallback: weather can be configured from Appearance → Weather settings.
WEATHER_LAT=
WEATHER_LON=
